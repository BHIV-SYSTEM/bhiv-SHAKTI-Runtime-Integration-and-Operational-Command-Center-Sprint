# ==============================================================================
# NIYANTRAN KENDRA — Safe Frontend Environment Template
# ==============================================================================
# SECURITY NOTICE:
# - All VITE_* variables are statically embedded into the client JS bundle at build time.
# - NEVER place JWT_SECRET, private keys, database URIs, or server-only API keys here.
# - Copy to `.env.local` for local developer overrides (ignored by Git).

# ─── BHIV Core Centralized Authentication (Slug: niyantran) ──────────────────
# Canonical production Auth API server (GET /api/auth/sso/session?app=niyantran, POST /api/auth/logout)
# Local development example (.env.local): VITE_AUTH_SERVER_URL="http://localhost:8080"
VITE_AUTH_SERVER_URL="https://auth.blackholeinfiverse.com"

# Optional independent Auth Login UI origin for `/login?embed=1&app=niyantran` popup & postMessage origin check.
# Leave empty when `/login` is served from VITE_AUTH_SERVER_URL, or set explicitly when split
# (e.g. "https://products.blackholeinfiverse.com" in split-host prod, or "http://localhost:5173" locally).
VITE_AUTH_UI_URL=""

# ─── Active Backend & Runtime Service Proxy Routes (Non-Secret) ──────────────
VITE_CONTROL_PLANE_URL="/api/control-plane"
VITE_BUCKET_SERVICE_URL="/api/bucket"
VITE_PRANA_SERVICE_URL="/api/prana"
VITE_NIYANTRAN_URL="https://niyantran.blackholeinfiverse.com"
VITE_INSIGHTFLOW_URL="/api/insightflow"
VITE_TANTRA_BASE_URL="/api/tantra"
VITE_RAJYA_BASE_URL="/api/rajya"
VITE_SANSKAR_BASE_URL="/api/sanskar"
VITE_KARMA_URL="/api/karma"
VITE_KESHAV_URL="/api/keshav"
VITE_SETU_URL="https://setu.blackholeinfiverse.com"
VITE_PRAVAH_URL="/api/pravah"
VITE_MITRA_URL="/api/mitra"
VITE_MITRA_LIVE_URL="https://mitra.blackholeinfiverse.com"
